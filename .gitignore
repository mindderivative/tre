/target/
**/*.rs.bk
/.venv/
/site/
/tools/build-tracker-*.generated.html
# §14 step 6: Python/maturin build + test artifacts.
__pycache__/
*.pyc
/.pytest_cache/
*.egg-info/
/dist/
# `maturin develop`'s compiled extension, dropped directly into
# python/tre/ -- platform/Python-version-specific (this dev machine's
# is `_core.cpython-314-x86_64-linux-gnu.so`), regenerated by anyone who
# runs `maturin develop` themselves, never something to commit.
python/tre/*.so
python/tre/*.pyd
python/tre/*.dylib
# graphify-out/ is ignored. It was committed once (c817406), and a .gitignore entry
# does not untrack files that are already tracked: those stay tracked, and show
# changes on every rebuild, until `git rm -r --cached graphify-out` removes them.
# The more specific lines below still apply to anything not tracked: the two files
# graphify writes with this machine's absolute paths in them (the interpreter it ran
# under and the scan root), and the Obsidian vault `graphify export obsidian` writes.
/graphify-out/
/graphify-out/.graphify_python
/graphify-out/.graphify_root
/graphify-out/obsidian/
