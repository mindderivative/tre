# `maturin develop`'s compiled extension, dropped directly into
# python/tre/ -- platform/Python-version-specific (this dev machine's
# is `_core.cpython-314-x86_64-linux-gnu.so`), regenerated by anyone who
# runs `maturin develop` themselves, never something to commit.
python/tre/*.so
python/tre/*.pyd
python/tre/*.dylib
